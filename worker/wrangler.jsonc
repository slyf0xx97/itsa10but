{
  // itsa10but edge: called server-to-server by the Vercel app. IDs below are filled in by `wrangler d1 create` / `wrangler kv namespace create`.
  "name": "itsa10but-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "triggers": { "crons": ["30 18 * * *", "0 * * * *"] },
  "preview_urls": false,
  "ai": { "binding": "AI" },
  // Cloudflare Access for admin.ghernie.com. Neither value is secret. The owner's address is the ADMIN_EMAIL secret.
  "vars": { "ACCESS_TEAM": "lucky-resonance-0aea.cloudflareaccess.com", "ACCESS_AUD": "d74b8ee307447e28dca224d08136b83298257a96a561456a6cc6ff345c2cf272" },
  // edge.ghernie.com is the machine-to-machine host. admin.ghernie.com is the owner's admin hub: one Cloudflare Access app guards the whole host, and each project's Worker takes its own path (this one: /itsa10but).
  "routes": [
    { "pattern": "edge.ghernie.com", "custom_domain": true },
    { "pattern": "admin.ghernie.com/itsa10but", "zone_name": "ghernie.com" },
    { "pattern": "admin.ghernie.com/itsa10but/*", "zone_name": "ghernie.com" }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "edd6a90313424b0bb659ce225404d8cc" }],
  "d1_databases": [{ "binding": "DB", "database_name": "itsa10but-edge", "database_id": "7c8c526e-1f06-4767-a8c6-b6547701577e" }]
}
